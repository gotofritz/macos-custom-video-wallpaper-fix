#!/bin/bash

## Usage:
## ./download_movie YOUTUBEID REFERENCE [--loop] START1 END1 [START2 END2 ...]
##
## Examples:
## ./download_movie 'rVyQHMVhkrE' '4C108785-A7BA-422E-9C79-B0129F1D5550' \
##   '00:05' '04:29'
##
## ./download_movie 'rVyQHMVhkrE' '4C108785-A7BA-422E-9C79-B0129F1D5550' --loop \
##   '00:05' '00:20' '01:10' '01:35' '04:00' '04:29'

set -Eeuo pipefail

trap 'rc=$?; echo "ERROR: line ${LINENO}: ${BASH_COMMAND} (exit ${rc})" >&2' ERR

log() {
    echo "[$(date '+%H:%M:%S')] $*" >&2
}

die() {
    log "ERROR: $*"
    exit 1
}

# ------------------------------------------------------------
# Arguments
# ------------------------------------------------------------

if (( $# < 4 )); then
    echo "Usage: $0 YOUTUBEID REFERENCE [--loop] START1 END1 [START2 END2 ...]" >&2
    exit 2
fi

YOUTUBEID="$1"
REFERENCE="$2"
shift 2

LOOP=0
if [[ "${1:-}" == "--loop" ]]; then
    LOOP=1
    shift
fi

if (( $# < 2 || $# % 2 != 0 )); then
    die "START/END arguments must be supplied in pairs."
fi

OUTPUT="/Users/fritz/Library/Application Support/com.apple.wallpaper/aerials/videos/${REFERENCE}.mov"
INPUT="/Users/fritz/Documents/desktops/${YOUTUBEID}"

# ------------------------------------------------------------
# Validate dependencies and input arguments
# ------------------------------------------------------------

for cmd in ffmpeg ffprobe yt-dlp awk; do
    command -v "$cmd" >/dev/null 2>&1 || die "Required command not found: $cmd"
done

[[ -f "$OUTPUT" ]] || die "Target wallpaper does not exist: $OUTPUT"

SEGMENTS=()
TOTAL_SOURCE_DURATION=0

while (( $# )); do
    START="$1"
    END="$2"
    shift 2

    # Accept MM:SS or HH:MM:SS.
    time_to_seconds() {
        awk -F: '
            NF == 2 {
                if ($1 !~ /^[0-9]+$/ || $2 !~ /^[0-9]+([.][0-9]+)?$/ || $2 >= 60) exit 1
                print ($1 * 60) + $2
                exit
            }
            NF == 3 {
                if ($1 !~ /^[0-9]+$/ || $2 !~ /^[0-9]+$/ ||
                    $3 !~ /^[0-9]+([.][0-9]+)?$/ ||
                    $2 >= 60 || $3 >= 60) exit 1
                print ($1 * 3600) + ($2 * 60) + $3
                exit
            }
            { exit 1 }
        ' <<< "$1"
    }

    START_S=$(time_to_seconds "$START") ||
        die "Invalid start time: $START"

    END_S=$(time_to_seconds "$END") ||
        die "Invalid end time: $END"

    # These timestamps are whole seconds in the usual MM:SS form.
    if awk -v s="$START_S" -v e="$END_S" 'BEGIN { exit !(e > s) }'; then
        :
    else
        die "END ($END) must be after START ($START)."
    fi

    SEGMENTS+=("$START" "$END" "$START_S" "$END_S")
    TOTAL_SOURCE_DURATION=$(awk \
        -v total="$TOTAL_SOURCE_DURATION" \
        -v start="$START_S" -v end="$END_S" \
        'BEGIN { printf "%.6f", total + end - start }')
done

log "Video ID: $YOUTUBEID"
log "Reference: $REFERENCE"
log "Loop mode: $LOOP"
log "Source duration total: ${TOTAL_SOURCE_DURATION}s"
log "Output: $OUTPUT"

# ------------------------------------------------------------
# Inspect target wallpaper
# ------------------------------------------------------------

log "Reading target wallpaper properties..."

TARGET_DURATION=$(ffprobe -v error \
    -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 \
    "$OUTPUT") || die "Could not read target duration."

TARGET_W=$(ffprobe -v error -select_streams v:0 \
    -show_entries stream=width -of csv=p=0 "$OUTPUT") ||
    die "Could not read target width."

TARGET_H=$(ffprobe -v error -select_streams v:0 \
    -show_entries stream=height -of csv=p=0 "$OUTPUT") ||
    die "Could not read target height."

[[ -n "$TARGET_DURATION" && -n "$TARGET_W" && -n "$TARGET_H" ]] ||
    die "Target wallpaper metadata is incomplete."

awk -v d="$TARGET_DURATION" 'BEGIN { exit !(d > 0) }' ||
    die "Target duration is not positive: $TARGET_DURATION"

log "Target duration: ${TARGET_DURATION}s"
log "Target dimensions: ${TARGET_W}x${TARGET_H}"

# ------------------------------------------------------------
# Download source video
# ------------------------------------------------------------

if [[ -f "$INPUT.mp4" ]]; then
    log "Using existing source file: $INPUT.mp4"
else
    log "Downloading source video: $YOUTUBEID"
    yt-dlp \
        --min-sleep-interval 60 \
        --max-sleep-interval 90 \
        --no-progress \
        -o "$INPUT.%(ext)s" \
        -t mp4 -- "$YOUTUBEID" ||
        die "yt-dlp download failed."
fi

[[ -f "$INPUT.mp4" ]] || die "Source MP4 not found: $INPUT.mp4"

# ------------------------------------------------------------
# Temporary workspace
# ------------------------------------------------------------

TMPDIR_WORK=$(mktemp -d "${TMPDIR:-/tmp}/download_movie.XXXXXX") ||
    die "Could not create temporary directory."

cleanup() {
    rc=$?
    if [[ -n "${TMPDIR_WORK:-}" && -d "$TMPDIR_WORK" ]]; then
        rm -rf "$TMPDIR_WORK"
    fi
    exit "$rc"
}
trap cleanup EXIT

CONCAT_FILE="$TMPDIR_WORK/concat.txt"
: > "$CONCAT_FILE"

# ------------------------------------------------------------
# Extract each segment once
# ------------------------------------------------------------

CLIP_COUNT=0

for (( i=0; i<${#SEGMENTS[@]}; i+=4 )); do
    START="${SEGMENTS[$i]}"
    END="${SEGMENTS[$((i + 1))]}"
    START_S="${SEGMENTS[$((i + 2))]}"
    END_S="${SEGMENTS[$((i + 3))]}"

    CLIP="$TMPDIR_WORK/clip_${CLIP_COUNT}.mov"

    log "Extracting segment $((CLIP_COUNT + 1)): $START -> $END"

    ffmpeg -hide_banner -y \
        -ss "$START_S" -i "$INPUT.mp4" \
        -t "$(awk -v s="$START_S" -v e="$END_S" 'BEGIN { print e-s }')" \
        -map 0:v:0 -an \
        -vf "setpts=PTS-STARTPTS" \
        -c:v prores_ks \
        "$CLIP" ||
        die "Failed to extract segment $START -> $END."

    [[ -s "$CLIP" ]] || die "Extracted clip is empty: $CLIP"

    printf "file '%s'\n" "$CLIP" >> "$CONCAT_FILE"
    CLIP_COUNT=$((CLIP_COUNT + 1))
done

(( CLIP_COUNT > 0 )) || die "No clips were created."

# ------------------------------------------------------------
# Repeat the complete sequence if --loop was requested
# ------------------------------------------------------------

if (( LOOP )); then
    REPEATS=$(awk \
        -v target="$TARGET_DURATION" \
        -v source="$TOTAL_SOURCE_DURATION" \
        'BEGIN {
            if (source <= 0) exit 1
            print int(target / source) + 1
        }') || die "Could not calculate loop count."

    log "Repeating segment sequence $REPEATS times."

    for (( repeat=1; repeat<REPEATS; repeat++ )); do
        for (( clip=0; clip<CLIP_COUNT; clip++ )); do
            printf "file '%s/clip_%s.mov'\n" \
                "$TMPDIR_WORK" "$clip" >> "$CONCAT_FILE"
        done
    done
fi

# ------------------------------------------------------------
# Assemble, scale/crop, and set final duration
# ------------------------------------------------------------

FILTER="scale=iw*max(${TARGET_W}/iw\,${TARGET_H}/ih):ih*max(${TARGET_W}/iw\,${TARGET_H}/ih),crop=${TARGET_W}:${TARGET_H},format=yuv420p10le"

if (( ! LOOP )); then
    # Preserve the original behavior: stretch the full sequence.
    FILTER="${FILTER},setpts=${TARGET_DURATION}/${TOTAL_SOURCE_DURATION}*PTS"
fi

log "Assembling final movie..."
log "Playback speed: $([[ $LOOP -eq 1 ]] && echo original || echo adjusted-to-target)"
log "Encoding final output as HEVC Main 10, 10-bit 4:2:0, 30 fps..."

ffmpeg -hide_banner -y \
    -f concat -safe 0 -i "$CONCAT_FILE" \
    -map 0:v:0 -an \
    -vf "${FILTER},fps=30" \
    -t "$TARGET_DURATION" \
    -c:v libx265 \
    -profile:v main10 \
    -pix_fmt yuv420p10le \
    -tag:v hvc1 \
    -crf 16 \
    -preset medium \
    -movflags +faststart \
    "$OUTPUT" ||
    die "Final FFmpeg HEVC assembly failed."

[[ -s "$OUTPUT" ]] || die "Output file was not created."

log "Verifying output..."

ACTUAL_DURATION=$(ffprobe -v error
    -show_entries format=duration -of default=noprint_wrappers=1:nokey=1
    "$OUTPUT") || die "Could not verify output duration."

ACTUAL_CODEC=$(ffprobe -v error -select_streams v:0
    -show_entries stream=codec_name,profile,width,height,pix_fmt,r_frame_rate,avg_frame_rate
    -of default=noprint_wrappers=1 "$OUTPUT") ||
    die "Could not verify output video properties."

log "Finished successfully."
log "Output: $OUTPUT"
log "Target duration: ${TARGET_DURATION}s"
log "Actual duration: ${ACTUAL_DURATION}s"
log "Output video properties:"
printf '%s\n' "$ACTUAL_CODEC" >&2
